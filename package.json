{
  "name": "streammd",
  "version": "0.1.1",
  "description": "Markdown for JavaScript and Vue, with built-in completion, math, diagrams and custom extensions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "main": "./dist/core.js",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./vue": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/declarations.mjs && node scripts/assets.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev": "vite --config demo/vite.config.ts --host 127.0.0.1",
    "docs": "vite --config demo/vite.config.ts --host 127.0.0.1",
    "docs:build": "vite build --config demo/vite.config.ts",
    "benchmark": "node benchmarks/serve.mjs",
    "prepack": "npm run build",
    "benchmark:core": "node benchmarks/core/run.mjs",
    "release:check": "node scripts/release-check.mjs",
    "benchmark:report": "node scripts/summarize-benchmarks.mjs",
    "benchmark:compare": "npm --prefix benchmarks/comparison start",
    "benchmark:comparison-report": "node scripts/summarize-comparison.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "katex": "0.16.25",
    "marked": "17.0.1",
    "mermaid": "11.16.1",
    "remend": "1.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "d3-scale": "4.0.2",
    "jsdom": "^26.0.0",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "4.1.8",
    "vue": "^3.5.0",
    "vue-tsc": "3.1.5"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshangiga/StreamMD.git"
  },
  "homepage": "https://github.com/roshangiga/StreamMD#readme",
  "bugs": {
    "url": "https://github.com/roshangiga/StreamMD/issues"
  }
}
